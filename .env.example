# Configure the actual key as a secret through Sites. Never commit a real key.
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# Audio transcription is independent; recording and playback work without it.
TRANSCRIPTION_PROVIDER=none
# Optional previous provider; used only if explicitly selected.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
